<UserControl x:Class="CloudLight.CodexBridge.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1180" HorizontalAlignment="Left">
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="Codex" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding CodexState}" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="{Binding SessionCount}" Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="QQ 官方机器人" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding QqState}" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="远程 #N 路由" Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,12,0">
                    <StackPanel><TextBlock Text="Telegram" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding TelegramState}" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="Bot 与 Binding" Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel><TextBlock Text="消息同步" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding MirrorState}" Style="{StaticResource MetricValueStyle}"/><TextBlock Text="每个 Turn 最多一个 Final" Style="{StaticResource SecondaryTextStyle}"/></StackPanel>
                </Border>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="当前工作区" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="当前 Thread" Style="{StaticResource EyebrowTextStyle}" Margin="0,18,0,4"/>
                        <TextBox Text="{Binding CurrentThread, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}"/>
                        <Separator Margin="0,16"/>
                        <TextBlock Text="Running Turn" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="{Binding RunningTurn}" FontSize="18" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="最近活动" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox Text="{Binding RecentActivity, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,16,0,0"/>
                        <TextBlock Text="首页仅保留运行概况。渠道凭据、同步目标和高级设置分别在对应页面管理。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
