<UserControl x:Class="CloudLight.CodexBridge.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}"/><CheckBox Content="关闭窗口时最小化到系统托盘" IsChecked="{Binding CloseToTray}" Margin="0,15,0,0"/><CheckBox Content="恢复上次打开的页面" IsChecked="{Binding RestoreLastPage}" Margin="0,10,0,0"/><CheckBox Content="自动刷新 Thread" IsChecked="{Binding AutoRefreshThreads}" Margin="0,10,0,0"/><TextBlock Text="Thread 刷新间隔（秒）" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5"/><ComboBox ItemsSource="{Binding ThreadRefreshIntervals}" SelectedItem="{Binding ThreadRefreshIntervalSeconds}" Width="150" HorizontalAlignment="Left"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="启动" Style="{StaticResource SectionTitleStyle}"/><CheckBox Content="开机自动启动 CloudLight Codex Bridge" IsChecked="{Binding StartWithWindows}" Margin="0,15,0,0"/><CheckBox Content="开机时静默启动（--silent）" IsChecked="{Binding SilentStartup}" Margin="0,10,0,0"/><CheckBox Content="自动启动 QQ" IsChecked="{Binding QqAutoStart}" Margin="0,10,0,0"/><CheckBox Content="自动启动 Telegram" IsChecked="{Binding TelegramAutoStart}" Margin="0,10,0,0"/><CheckBox Content="自动启动 Codex 消息同步" IsChecked="{Binding MirrorAutoStart}" Margin="0,10,0,0"/><TextBlock Text="用户级 HKCU 启动项，不需要管理员权限。" Style="{StaticResource SecondaryTextStyle}" Margin="0,14,0,0"/></StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="主题" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,5"/><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="180" HorizontalAlignment="Left"/><TextBlock Text="system 跟随 Windows 应用主题；主题资源会即时刷新。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Text="数据位置" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="Bridge 数据" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,4"/><TextBox Text="{Binding DataDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}"/><Button Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock Text="日志" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/><TextBox Text="{Binding LogDirectory, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}"/><Button Content="打开日志目录" Command="{Binding OpenLogDirectoryCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel><TextBlock Text="Codex" Style="{StaticResource SectionTitleStyle}"/><TextBlock Text="当前检测" Style="{StaticResource FieldLabelStyle}" Margin="0,15,0,4"/><TextBox Text="{Binding CodexDetection, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}"/><TextBlock Text="自定义 Codex CLI 路径" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,5"/><TextBox Text="{Binding CodexCustomPath, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="留空时使用 PATH 自动检测；路径在下次启动生效。" Style="{StaticResource SecondaryTextStyle}" Margin="0,7,0,0"/></StackPanel>
            </Border>
            <Expander Header="高级" IsExpanded="False" Margin="0,0,0,16">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0"><StackPanel><TextBlock Text="新 Turn 沙盒模式" Style="{StaticResource FieldLabelStyle}"/><ComboBox ItemsSource="{Binding SandboxModes}" SelectedItem="{Binding SandboxMode}" Width="200" HorizontalAlignment="Left"/><TextBlock Text="审批策略" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4"/><TextBox Text="{Binding ApprovalPolicy, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}"/><TextBlock Text="该设置只影响后续新 Turn，不改变正在运行的任务，也不提供危险完全权限开关。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
            </Expander>
            <StackPanel Orientation="Horizontal"><Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}"/><TextBox Text="{Binding SaveResult, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="14,0,0,0" MaxWidth="700" VerticalAlignment="Center"/></StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
