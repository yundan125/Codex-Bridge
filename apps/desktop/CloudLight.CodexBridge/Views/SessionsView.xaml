<UserControl x:Class="CloudLight.CodexBridge.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{StaticResource SessionsTitle}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{StaticResource Refresh}" Command="{Binding RefreshCommand}" />
                </Grid>
                <TextBox Grid.Row="1" Margin="14,0,14,12" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{StaticResource SearchHint}" />
                <ListBox Grid.Row="2" ItemsSource="{Binding ThreadsView}" SelectedItem="{Binding SelectedThread, Mode=TwoWay}"
                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E1E6EB" BorderThickness="0,0,0,1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding NumberedTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Cwd}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding UpdatedAt}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="8,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#D8DEE5" />

        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid Visibility="{Binding EmptyVisibility}" Background="White">
                    <TextBlock Text="{StaticResource SelectThreadHint}" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
                </Grid>

                <Grid Visibility="{Binding LoadingVisibility}" Background="White">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="180" Height="4" IsIndeterminate="True" />
                        <TextBlock Text="正在读取真实 Codex Thread…" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding ErrorVisibility}" Background="White">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Thread 读取失败" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorText}" Foreground="#B42318" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,14" />
                        <Button Content="重试" Command="{Binding RetryCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Grid Visibility="{Binding DetailsVisibility}" Background="{DynamicResource CardBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#DDE3EA" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding SelectedDetail.NumberPrefix}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="{Binding SelectedDetail.Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding RuntimeStateText}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RuntimeSourceText}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                    <TextBlock Text="{Binding CurrentTurnId}" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="打开" Command="{Binding OpenDirectoryCommand}" Margin="0,0,7,0"/>
                                <Button Content="复制 #N" Command="{Binding CopyThreadPrefixCommand}" Margin="0,0,7,0"/>
                                <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding CanStop}" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,7,0"/>
                                <Menu Background="Transparent" VerticalAlignment="Center"><MenuItem Header="•••"><MenuItem Header="复制 Thread ID" Command="{Binding CopyThreadIdCommand}"/><MenuItem Header="重新验证持久化" Command="{Binding VerifyPersistenceCommand}"/></MenuItem></Menu>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <Border Background="{DynamicResource CodeBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Thread ID" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                    <TextBox Grid.Column="1" Text="{Binding SelectedDetail.ThreadId, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" FontFamily="Consolas" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Text="项目目录" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDetail.Cwd, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Text="模型" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDetail.Model}" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Text="创建时间" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDetail.CreatedAt}" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Text="更新时间" Foreground="{StaticResource MutedBrush}" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDetail.UpdatedAt}" Margin="0,2" />
                                </Grid>
                            </Border>

                            <Border Visibility="{Binding PersistenceVerificationVisibility}" Background="{DynamicResource CodeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="持久化验证" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding PersistenceVerificationText, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding PendingInteractions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="等待本机处理" Foreground="#8A5A00" />
                                                </Grid>
                                                <TextBox Text="{Binding Description, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,7,0,0" />
                                                <Border Visibility="{Binding CommandVisibility}" Background="#202A34" CornerRadius="4" Padding="10" Margin="0,10,0,0">
                                                    <StackPanel>
                                                        <TextBox Text="{Binding Command, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Foreground="#F2F5F7" FontFamily="Consolas" />
                                                        <TextBox Text="{Binding Cwd, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Foreground="#AEB9C4" FontSize="11" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBox Visibility="{Binding FileChangesVisibility}" Text="{Binding FileChangesText, Mode=OneWay}" Style="{StaticResource CodeTextStyle}" Margin="0,10,0,0" />

                                                <StackPanel Visibility="{Binding UserInputVisibility}" Margin="0,10,0,0">
                                                    <ItemsControl ItemsSource="{Binding Questions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,0,0,12">
                                                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,3,0,6" />
                                                                    <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding SingleChoiceVisibility}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <RadioButton Content="{Binding Label}" GroupName="{Binding GroupName}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding MultipleChoiceVisibility}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,3" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBox Text="{Binding TextAnswer, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding TextVisibility}"
                                                                             AcceptsReturn="True" MinHeight="58" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="提交回答" Command="{Binding DataContext.SubmitAnswersCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" IsEnabled="{Binding CanSubmit}" HorizontalAlignment="Left" />
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding ApprovalVisibility}" Orientation="Horizontal" Margin="0,12,0,0">
                                                    <Button Content="允许一次" Visibility="{Binding AllowVisibility}"
                                                            Command="{Binding DataContext.AllowInteractionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                            Background="{StaticResource AccentBrush}" Foreground="White" />
                                                    <Button Content="拒绝" Command="{Binding DataContext.DenyInteractionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="消息与工具事件" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <ItemsControl ItemsSource="{Binding Timeline}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,9">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Timestamp}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="9,1,0,0"/></StackPanel>
                                                    <Border Grid.Column="1" Style="{StaticResource BadgeStyle}"><TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="11" /></Border>
                                                </Grid>
                                                <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,9,0,0" Visibility="{Binding MessageVisibility}" FontSize="14" />
                                                <Expander Header="查看工具详情" Visibility="{Binding ExpandableVisibility}" Margin="0,6,0,0">
                                                    <TextBox Text="{Binding Text, Mode=OneWay}" Style="{StaticResource CodeTextStyle}" MaxHeight="300" VerticalScrollBarVisibility="Auto" />
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#DDE3EA" BorderThickness="0,1,0,0" Padding="16">
                        <StackPanel>
                            <TextBox Text="{Binding ActionError, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Foreground="{DynamicResource ErrorBrush}" Visibility="{Binding ActionErrorVisibility}" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto" ToolTip="Ctrl+Enter 发送纯文本消息">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Button Content="发送" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" MinWidth="88"
                                            Background="{StaticResource AccentBrush}" Foreground="White" />
                                    <TextBlock Text="Ctrl+Enter" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
