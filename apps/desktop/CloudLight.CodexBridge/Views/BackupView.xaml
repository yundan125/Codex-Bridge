<UserControl x:Class="CloudLight.CodexBridge.Views.BackupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel MaxWidth="1480" HorizontalAlignment="Stretch">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="数据与备份" Style="{StaticResource SectionTitleStyle}"/>
                <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Codex 数据位置" Style="{StaticResource EyebrowTextStyle}"/><TextBox Text="{Binding CodexHome, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,6,12,0"/><TextBlock Text="{Binding DataSummary}" Style="{StaticResource MetricValueStyle}" Margin="0,10,0,0"/></StackPanel>
                    <Button Grid.Column="1" Content="打开数据位置" Command="{Binding OpenCodexHomeCommand}" VerticalAlignment="Bottom"/>
                </Grid>
            </Grid></Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="创建备份" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="完整备份保存当前全部内容；增量备份只保存相对上一次备份的变化和删除记录。首次请创建完整备份。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                <WrapPanel Margin="0,0,0,12"><RadioButton Content="完整备份" IsChecked="{Binding IsFullBackup}" GroupName="BackupType" Margin="0,0,24,8"/><RadioButton Content="增量备份" IsChecked="{Binding IsIncremental}" GroupName="BackupType" Margin="0,0,24,8"/></WrapPanel>
                <WrapPanel Margin="0,0,0,12"><CheckBox Content="Codex 数据" IsChecked="{Binding IncludeCodex}" Margin="0,0,24,8"/><CheckBox Content="CloudLight Codex Bridge 数据" IsChecked="{Binding IncludeBridge}" Margin="0,0,24,8"/></WrapPanel>
                <DockPanel LastChildFill="False"><Button Content="创建备份" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/><Button Content="取消" Command="{Binding CancelBackupCommand}"/></DockPanel>
            </StackPanel></Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel>
                <TextBlock Text="选择恢复内容" Style="{StaticResource SectionTitleStyle}"/>
                <TextBlock Text="选择备份后会先校验完整备份和全部增量链，再允许恢复。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                <Button Content="选择 .clcbak 文件" Command="{Binding SelectBackupCommand}" HorizontalAlignment="Left"/>
                <TextBox Text="{Binding SelectedBackup, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,9,0,0"/>
                <Expander Header="备份详情" Visibility="{Binding BackupDetailsVisibility}" Margin="0,12,0,0"><TextBox Text="{Binding BackupDetails, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}"/></Expander>
                <StackPanel Visibility="{Binding BackupDetailsVisibility}" Margin="0,16,0,0">
                    <TextBlock Text="恢复分类" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <CheckBox Content="项目" IsChecked="{Binding RestoreProjects}" Margin="0,0,24,10"/><CheckBox Content="Codex 对话" IsChecked="{Binding RestoreConversations}" Margin="0,0,24,10"/>
                        <CheckBox Content="OpenClaw 会话" IsChecked="{Binding RestoreOpenClaw}" Margin="0,0,24,10"/><CheckBox Content="QQ 机器人" IsChecked="{Binding RestoreQq}" Margin="0,0,24,10"/>
                        <CheckBox Content="Telegram 机器人" IsChecked="{Binding RestoreTelegram}" Margin="0,0,24,10"/><CheckBox Content="软件配置" IsChecked="{Binding RestoreSoftwareSettings}" Margin="0,0,24,10"/>
                        <CheckBox Content="Codex 设置" IsChecked="{Binding RestoreCodexSettings}" Margin="0,0,24,10"/><CheckBox Content="Task 历史" IsChecked="{Binding RestoreTaskHistory}" Margin="0,0,24,10"/><CheckBox Content="日志" IsChecked="{Binding RestoreLogs}" Margin="0,0,24,10"/>
                    </WrapPanel>
                    <Expander Header="按项目选择 Codex 对话" IsExpanded="False" Margin="0,8,0,0"><ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ConversationGroups}">
                            <ItemsControl.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander Header="{Binding Name}" IsExpanded="False" Margin="0,4"><ItemsPresenter Margin="16,6,0,8"/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource SecondaryTextStyle}" Margin="12,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer></Expander>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0"><TextBlock Text="{Binding RestorePreview}" TextWrapping="Wrap"/></Border>
                    <WrapPanel Margin="0,14,0,0"><RadioButton Content="完整替换（推荐）" IsChecked="{Binding ReplaceMode}" GroupName="RestoreMode" Margin="0,0,24,8"/><RadioButton Content="合并（保留已有文件）" GroupName="RestoreMode" Margin="0,0,24,8"/></WrapPanel>
                    <Button Content="确认恢复" Command="{Binding RestoreCommand}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel></Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{Binding BusyVisibility}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{Binding ProgressStage}" TextWrapping="Wrap"/><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Height="5" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"><StackPanel><TextBlock Text="当前操作" Style="{StaticResource SectionTitleStyle}"/><TextBox Text="{Binding OperationText, Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,10,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="最近操作" Style="{StaticResource SectionTitleStyle}"/><ItemsControl ItemsSource="{Binding RecentOperations}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource ReadOnlyTextStyle}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
