<Application x:Class="CloudLight.CodexBridge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CloudLight.CodexBridge.ViewModels"
             xmlns:views="clr-namespace:CloudLight.CodexBridge.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Strings.zh-CN.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="WindowColor">#F4F6F8</Color>
            <Color x:Key="SurfaceColor">#FFFFFF</Color>
            <Color x:Key="SidebarColor">#17212B</Color>
            <Color x:Key="AccentColor">#2878C8</Color>
            <Color x:Key="TextColor">#1D2733</Color>
            <Color x:Key="MutedColor">#657181</Color>
            <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
                <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="BorderBrush" Value="#CBD3DC" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="#DDE3EA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SidebarButtonStyle" TargetType="Button">
                <Setter Property="Foreground" Value="#E8EDF2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="18,12" />
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <DataTemplate DataType="{x:Type viewModels:SessionsViewModel}">
                <views:SessionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ChannelsViewModel}">
                <views:ChannelsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>

